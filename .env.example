# Chalkline.AI Environment Configuration
# Copy this file to .env and fill in your actual values

# ===================================
# Gateway API Configuration
# ===================================
# URL for the LLM Gateway backend service
VITE_GATEWAY_URL=http://localhost:3001

# ===================================
# AI Provider API Keys
# ===================================
# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===================================
# Application Settings
# ===================================
# Environment: development, staging, or production
NODE_ENV=development

# Gateway server port
PORT=3001

# ===================================
# Security Settings
# ===================================
# CORS allowed origins (comma-separated for multiple)
# In production, set this to your actual frontend domain
CORS_ORIGINS=http://localhost:5173

# Session secret for secure sessions
SESSION_SECRET=your_session_secret_here_change_in_production

# ===================================
# Tenant Configuration
# ===================================
# Default tenant ID (for development/testing)
DEFAULT_TENANT_ID=oakwood-high

# ===================================
# Feature Flags
# ===================================
# Enable/disable specific features
ENABLE_PDF_ANNOTATIONS=true
ENABLE_WHITEBOARD=true
ENABLE_AI_POLICY=true
ENABLE_COLLABORATION=false

# ===================================
# Monitoring & Logging
# ===================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# ===================================
# Rate Limiting
# ===================================
# Requests per minute per IP
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ===================================
# Database Configuration (Future)
# ===================================
# DATABASE_URL=postgresql://user:password@localhost:5432/chalkline
# REDIS_URL=redis://localhost:6379

# ===================================
# External Integrations (Future)
# ===================================
# Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft OAuth
# MICROSOFT_CLIENT_ID=your_microsoft_client_id
# MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# LMS Integration
# CANVAS_API_KEY=your_canvas_api_key
# CANVAS_BASE_URL=https://your-school.instructure.com
